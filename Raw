local function setTouchFlingGuiState(state)
	CFG.TouchFlingGui = state
	saveCFG()

	if state then
		if next(loadedTouchFlingGuisms) == nil then
			local existingGuis = {}
			for _, gui in ipairs(playerGui:GetChildren()) do
				if gui:IsA("ScreenGui") then existingGuis[gui] = true end
			end

			pcall(function()
				loadstring(game:HttpGet("https://pastebin.com/raw/jy7LwJrh"))()
			end)

			task.spawn(function()
				task.wait(0.3)
				for _, gui in ipairs(playerGui:GetChildren()) do
					if gui:IsA("ScreenGui") and not existingGuis[gui] and gui.Name ~= "MobileControlGui" then
						loadedTouchFlingGuisms[gui] = true
						gui.Enabled = true
					end
				end
			end)
		else
			for gui, _ in pairs(loadedTouchFlingGuisms) do
				if gui and gui.Parent then
					gui.Enabled = true
				end
			end
		end
	else
		for gui, _ in pairs(loadedTouchFlingGuisms) do
			if gui and gui.Parent then
				gui.Enabled = false
			end
		end
	end
end

local function setShiftlockState(state)
	CFG.Shiftlock = state
	saveCFG()
	
	local function scanAndApply(parent)
		local found = false
		for _, obj in ipairs(parent:GetChildren()) do
			local nameLower = string.lower(obj.Name)
			if string.find(nameLower, "shift") or string.find(nameLower, "lock") or string.find(nameLower, "inf") then
				if obj:IsA("ScreenGui") then
					obj.Enabled = state
					found = true
				end
			end
		end
		return found
	end

	if state then
		local activeInPlayerGui = scanAndApply(playerGui)
		local activeInCoreGui = scanAndApply(CoreGui)
		
		if not (activeInPlayerGui or activeInCoreGui) then
			pcall(function()
				loadstring(game:HttpGet("https://raw.githubusercontent.com/INF-HH/-/refs/heads/main/Script"))()
			end)
			
			task.spawn(function()
				local attempts = 0
				while attempts < 10 do
					task.wait(0.2)
					if scanAndApply(playerGui) or scanAndApply(CoreGui) then
						break
					end
					attempts = attempts + 1
				end
			end)
		end
	else
		pcall(function()
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			if player.Character then
				local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.CameraOffset = Vector3.zero
					humanoid.AutoRotate = true
				end
			end
			
			scanAndApply(playerGui)
			scanAndApply(CoreGui)
		end)
	end
end

local function makeSingleFingerDraggable(guiObject, isMainButton)
	local dragging = false
	local dragInput, dragStart, startPos

	guiObject.InputBegan:Connect(function(input)
		if isMainButton and CFG.LockAllButtons then return end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = guiObject.Position
			
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	guiObject.InputChanged:Connect(function(input)
		if isMainButton and CFG.LockAllButtons then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if isMainButton and CFG.LockAllButtons then return end
		if input == dragInput and dragging then
			local delta = input.Position - dragStart
			guiObject.Position = UDim2.new(
				startPos.X.Scale, 
				startPos.X.Offset + delta.X, 
				startPos.Y.Scale, 
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function setGodModeState(state)
	CFG.GodModeActive = state
	saveCFG()

	if state then
		local function trackGodGui(container)
			container.ChildAdded:Connect(function(child)
				if child:IsA("ScreenGui") then
					table.insert(loadedGodModeObjects, child)
				end
			end)
		end
		trackGodGui(playerGui)
		pcall(function() trackGodGui(CoreGui) end)

		pcall(function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/Adamlollxoolest/Adam-made-this-god-mode-script-lolololol/refs/heads/main/God%20mode%20script%20made%20by%20admmmo6"))()
		end)
	else
		for _, gui in ipairs(loadedGodModeObjects) do
			if gui and gui.Parent then
				pcall(function() gui:Destroy() end)
			end
		end
		loadedGodModeObjects = {}

		local function cleanupGod(parent)
			for _, child in ipairs(parent:GetChildren()) do
				local nameLower = string.lower(child.Name)
				if (string.find(nameLower, "god") or string.find(nameLower, "adam")) and nameLower ~= "touchgui" and nameLower ~= "mobilecontrolgui" then
					pcall(function() child:Destroy() end)
				else
					cleanupGod(child)
				end
			end
		end
		pcall(function() cleanupGod(playerGui) end)
		pcall(function() cleanupGod(CoreGui) end)
	end
end

