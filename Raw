-- Mobile UI Setup
local function createMobileUI(setNoclipStateCallback)
	local existingGui = playerGui:FindFirstChild("MobileControlGui")
	if existingGui then existingGui:Destroy() end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "MobileControlGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local function makeButton(name, text, position, color)
		local button = Instance.new("TextButton")
		button.Name = name
		button.Size = UDim2.new(0, 130, 0, 45)
		button.Position = position
		button.BackgroundColor3 = color
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		button.TextScaled = true
		button.Font = Enum.Font.SourceSansBold
		button.Text = text
		button.Active = true
		button.Draggable = true
		button.Parent = screenGui

		local uiCorner = Instance.new("UICorner")
		uiCorner.CornerRadius = UDim.new(0, 10)
		uiCorner.Parent = button

		return button
	end

	local sprintBtn = makeButton("SprintButton", "Sprint: OFF", UDim2.new(0, 20, 0, 20), Color3.fromRGB(220, 50, 50))
	local antiFlingBtn = makeButton("AntiFlingButton", "Anti Fling: OFF", UDim2.new(0, 20, 0, 70), Color3.fromRGB(220, 50, 50))
	local wallRunBtn = makeButton("WallRunButton", "Wall Run: OFF", UDim2.new(0, 20, 0, 120), Color3.fromRGB(220, 50, 50))
	local glideBtn = makeButton("GlideButton", "Glide: OFF", UDim2.new(0, 20, 0, 170), Color3.fromRGB(220, 50, 50))
	local cfgBtn = makeButton("CFGButton", "CFG Menu", UDim2.new(0, 20, 0, 220), Color3.fromRGB(100, 100, 100))
	
	-- CFG Frame
	local cfgFrame = Instance.new("Frame")
	cfgFrame.Name = "CFGFrame"
	cfgFrame.Size = UDim2.new(0, 280, 0, 420)
	cfgFrame.Position = UDim2.new(0, 160, 0, 20)
	cfgFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	cfgFrame.Visible = false
	cfgFrame.Active = true
	cfgFrame.Parent = screenGui
	
	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 10)
	frameCorner.Parent = cfgFrame

	-- Dragging Logic
	local dragging, dragInput, dragStart, startPos

	local function updateDrag(input)
		local delta = input.Position - dragStart
		cfgFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end

	cfgFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = cfgFrame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	cfgFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			updateDrag(input)
		end
	end)

	local function createCFGInput(labelText, defaultVal, posY, callback)
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0, 170, 0, 30)
		label.Position = UDim2.new(0, 10, 0, posY)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.Text = labelText
		label.Font = Enum.Font.SourceSans
		label.TextSize = 14
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = cfgFrame

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(0, 80, 0, 30)
		box.Position = UDim2.new(0, 190, 0, posY)
		box.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		box.TextColor3 = Color3.fromRGB(255, 255, 255)
		box.Text = tostring(defaultVal)
		box.Font = Enum.Font.SourceSansBold
		box.TextSize = 14
		box.Parent = cfgFrame

		local boxCorner = Instance.new("UICorner")
		boxCorner.CornerRadius = UDim.new(0, 6)
		boxCorner.Parent = box

		local function updateValue()
			local num = tonumber(box.Text)
			if num then
				callback(num)
				saveCFG()
			else
				box.Text = tostring(defaultVal)
			end
		end

		box.FocusLost:Connect(updateValue)
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local num = tonumber(box.Text)
			if num then
				callback(num)
				saveCFG()
			end
		end)
	end

	local function createCFGToggle(labelText, defaultState, posY, callback)
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0, 190, 0, 30)
		label.Position = UDim2.new(0, 10, 0, posY)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.Text = labelText
		label.Font = Enum.Font.SourceSans
		label.TextSize = 14
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = cfgFrame

		local toggleBg = Instance.new("TextButton")
		toggleBg.Size = UDim2.new(0, 60, 0, 26)
		toggleBg.Position = UDim2.new(0, 200, 0, posY + 2)
		toggleBg.BackgroundColor3 = defaultState and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(80, 80, 80)
		toggleBg.Text = ""
		toggleBg.Parent = cfgFrame

		local bgCorner = Instance.new("UICorner")
		bgCorner.CornerRadius = UDim.new(1, 0)
		bgCorner.Parent = toggleBg

		local sliderKnob = Instance.new("Frame")
		sliderKnob.Size = UDim2.new(0, 22, 0, 22)
		sliderKnob.Position = defaultState and UDim2.new(1, -24, 0, 2) or UDim2.new(0, 2, 0, 2)
		sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		sliderKnob.Parent = toggleBg

		local knobCorner = Instance.new("UICorner")
		knobCorner.CornerRadius = UDim.new(1, 0)
		knobCorner.Parent = sliderKnob

		local state = defaultState

		local function setUIState(newState)
			state = newState
			if state then
				toggleBg.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
				sliderKnob.Position = UDim2.new(1, -24, 0, 2)
			else
				toggleBg.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
				sliderKnob.Position = UDim2.new(0, 2, 0, 2)
			end
		end

		toggleBg.MouseButton1Click:Connect(function()
			state = not state
			setUIState(state)
			callback(state)
			saveCFG()
		end)

		return setUIState
	end

	-- Textbox Inputs
	createCFGInput("Sprint Speed:", CFG.SprintSpeed, 10, function(val) CFG.SprintSpeed = val end)
	createCFGInput("Jump Power:", CFG.JumpPower, 45, function(val) 
		CFG.JumpPower = val
		if player.Character and player.Character:FindFirstChild("Humanoid") then
			player.Character.Humanoid.JumpPower = val
		end
	end)
	createCFGInput("Wall Speed:", CFG.WallRunSpeed, 80, function(val) CFG.WallRunSpeed = val end)
	createCFGInput("Glide Base (s):", CFG.BaseGlideDuration, 115, function(val) CFG.BaseGlideDuration = val end)
	createCFGInput("Glide Max (s):", CFG.MaxGlideDuration, 150, function(val) CFG.MaxGlideDuration = val end)

	-- Toggles Inside CFG
	local setNoclipUI = createCFGToggle("Noclip Toggle:", CFG.AutoNoclipOnExec, 190, function(state)
		CFG.AutoNoclipOnExec = state
		setNoclipStateCallback(state)
	end)

	createCFGToggle("Anti Fling (Exec On):", CFG.AutoAntiFlingOnExec, 225, function(state) CFG.AutoAntiFlingOnExec = state end)
	createCFGToggle("Sprint (Exec On):", CFG.AutoSprintOnExec, 260, function(state) CFG.AutoSprintOnExec = state end)
	createCFGToggle("Glide (On Sprint):", CFG.AutoGlideOnSprint, 295, function(state) CFG.AutoGlideOnSprint = state end)
	createCFGToggle("Wall Run (On Sprint):", CFG.AutoWallRunOnSprint, 330, function(state) CFG.AutoWallRunOnSprint = state end)

	cfgBtn.MouseButton1Click:Connect(function()
		cfgFrame.Visible = not cfgFrame.Visible
	end)

	wallRunBtn.Visible = false
	glideBtn.Visible = false

	return sprintBtn, antiFlingBtn, wallRunBtn, glideBtn, setNoclipUI
end

local function setupCustomAnimations(character)
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")
	local animator = humanoid:WaitForChild("Animator")

	local defaultAnimateScript = character:FindFirstChild("Animate")
	if defaultAnimateScript then
		defaultAnimateScript.Disabled = true
	end

	humanoid.WalkSpeed = CFG.WalkSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = CFG.JumpPower

	humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
		if humanoid.JumpPower ~= CFG.JumpPower then
			humanoid.JumpPower = CFG.JumpPower
		end
	end)

	local function loadAnimation(name, assetId, priority, looped)
		local anim = Instance.new("Animation")
		anim.AnimationId = assetId
		
		local success, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		
		if not success or not track then return nil, anim end

		track.Priority = priority or Enum.AnimationPriority.Action
		track.Looped = looped ~= nil and looped or false
		return track, anim
	end

	local idleTrack = loadAnimation("Idle", ANIMATIONS.Idle, Enum.AnimationPriority.Idle, true)
	local walkTrack = loadAnimation("Walk", ANIMATIONS.Walk, Enum.AnimationPriority.Action2, true)
	local runTrack = loadAnimation("Run", ANIMATIONS.Run, Enum.AnimationPriority.Action4, true)
	
	local normalJumpTrack = loadAnimation("NormalJump", ANIMATIONS.NormalJump, Enum.AnimationPriority.Action4, false)
	local sprintJumpTrack = loadAnimation("SprintJump", ANIMATIONS.SprintJump, Enum.AnimationPriority.Action4, false)
	local normalFallTrack = loadAnimation("NormalFall", ANIMATIONS.NormalFall, Enum.AnimationPriority.Action4, true)
	local sprintFallTrack = loadAnimation("SprintFall", ANIMATIONS.SprintFall, Enum.AnimationPriority.Action4, true)
	
	local normalClimbTrack = loadAnimation("NormalClimb", ANIMATIONS.NormalClimb, Enum.AnimationPriority.Action3, true)
	local sprintClimbTrack = loadAnimation("SprintClimb", ANIMATIONS.SprintClimb, Enum.AnimationPriority.Action4, true)

	local isJumping, isFalling, isClimbing, isSprinting = false, false, false, false
	local isWallRunning, isWallRunActive, isGlideActive, isGliding, isAntiFlingActive = false, false, false, false, false
	
	local glideStartTime = 0
	local calculatedGlideDuration = CFG.BaseGlideDuration
	local linearVelocity, glideAttachment = nil, nil
	local antiFlingConn, noclipConn, renderConn = nil, nil

	-- Persistent Trail Objects
	local att0 = Instance.new("Attachment")
	att0.Position = Vector3.new(0, 1, 0)
	att0.Parent = rootPart

	local att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, -1, 0)
	att1.Parent = rootPart

	local persistentTrail = Instance.new("Trail")
	persistentTrail.Attachment0 = att0
	persistentTrail.Attachment1 = att1
	persistentTrail.Lifetime = 0.5
	persistentTrail.MinLength = 0.05
	persistentTrail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255))
	persistentTrail.Transparency = NumberSequence.new(0.05, 1)
	persistentTrail.LightEmission = 1
	persistentTrail.Enabled = false
	persistentTrail.Parent = rootPart

	local function playSafe(track)
		if track then
			track.TimePosition = 0
			if not track.IsPlaying then track:Play() end
		end
	end

	local function stopSafe(track)
		if track and track.IsPlaying then track:Stop() end
	end

	local function stopAllMovement()
		stopSafe(walkTrack)
		stopSafe(runTrack)
	end

	local function stopAirAnimations()
		stopSafe(normalJumpTrack)
		stopSafe(sprintJumpTrack)
		stopSafe(normalFallTrack)
		stopSafe(sprintFallTrack)
	end

	local function stopClimbAnimations()
		stopSafe(normalClimbTrack)
		stopSafe(sprintClimbTrack)
	end

	local function stopAll()
		stopSafe(idleTrack)
		stopAllMovement()
		stopAirAnimations()
		stopClimbAnimations()
	end

	local function stopGliding()
		isGliding = false
		persistentTrail.Enabled = false
		if linearVelocity then linearVelocity:Destroy(); linearVelocity = nil end
		if glideAttachment then glideAttachment:Destroy(); glideAttachment = nil end
	end

	local function startGliding()
		if isGliding or not isSprinting or not isGlideActive then return end
		
		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {character}
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -500, 0), rayParams)
		local groundHeight = rayResult and (rootPart.Position.Y - rayResult.Position.Y) or 0
		
		calculatedGlideDuration = math.min(CFG.BaseGlideDuration + (groundHeight * CFG.HeightBonusFactor), CFG.MaxGlideDuration)
		isGliding = true
		glideStartTime = tick()

		if not glideAttachment then
			glideAttachment = Instance.new("Attachment")
			glideAttachment.Parent = rootPart
		end

		if not linearVelocity then
			linearVelocity = Instance.new("LinearVelocity")
			linearVelocity.Attachment0 = glideAttachment
			linearVelocity.MaxForce = 500000
			linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
			linearVelocity.Parent = rootPart
		end

		persistentTrail.Enabled = true
	end

	local function setAntiFlingState(enable)
		isAntiFlingActive = enable
		if antiFlingConn then antiFlingConn:Disconnect(); antiFlingConn = nil end

		if isAntiFlingActive then
			antiFlingConn = RunService.Stepped:Connect(function()
				if character and rootPart then
					for _, otherPlayer in ipairs(Players:GetPlayers()) do
						if otherPlayer ~= player and otherPlayer.Character then
							local otherRoot = otherPlayer.Character:FindFirstChild("HumanoidRootPart")
							if otherRoot and (otherRoot.Position - rootPart.Position).Magnitude < 5 then
								rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
							end
						end
					end
				end
			end)
		end
	end

	local function setNoclipState(enable)
		isNoclipActive = enable
		if noclipConn then noclipConn:Disconnect(); noclipConn = nil end

		if isNoclipActive then
			noclipConn = RunService.Stepped:Connect(function()
				if character then
					for _, part in ipairs(character:GetDescendants()) do
						if part:IsA("BasePart") then part.CanCollide = false end
					end
				end
			end)
		else
			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						if part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Head" then
							part.CanCollide = true
						else
							part.CanCollide = false
						end
					end
				end
			end
		end
	end

	local sprintBtn, antiFlingBtn, wallRunBtn, glideBtn, updateNoclipUI = createMobileUI(setNoclipState)

	local function toggleSprint(enable)
		isSprinting = enable
		humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
		wallRunBtn.Visible = isSprinting
		glideBtn.Visible = isSprinting

		if isSprinting then
			sprintBtn.Text = "Sprint: ON"
			sprintBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
			if CFG.AutoGlideOnSprint then isGlideActive = true; glideBtn.Text = "Glide: ON"; glideBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) end
			if CFG.AutoWallRunOnSprint then isWallRunActive = true; wallRunBtn.Text = "Wall Run: ON"; wallRunBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) end
		else
			sprintBtn.Text = "Sprint: OFF"
			sprintBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			isWallRunActive = false
			isWallRunning = false
			isGlideActive = false
			stopGliding()
			wallRunBtn.Text = "Wall Run: OFF"; wallRunBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			glideBtn.Text = "Glide: OFF"; glideBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			stopClimbAnimations()
		end
		stopAllMovement()
	end

	-- PC Controls
	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.LeftShift then toggleSprint(true) end
		if input.KeyCode == Enum.KeyCode.N then
			local newState = not isNoclipActive
			setNoclipState(newState)
			CFG.AutoNoclipOnExec = newState
			if updateNoclipUI then updateNoclipUI(newState) end
			saveCFG()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then toggleSprint(false) end
	end)

	-- Button Connections
	sprintBtn.MouseButton1Click:Connect(function() toggleSprint(not isSprinting) end)

	antiFlingBtn.MouseButton1Click:Connect(function()
		isAntiFlingActive = not isAntiFlingActive
		antiFlingBtn.Text = isAntiFlingActive and "Anti Fling: ON" or "Anti Fling: OFF"
		antiFlingBtn.BackgroundColor3 = isAntiFlingActive and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(220, 50, 50)
		setAntiFlingState(isAntiFlingActive)
	end)

	wallRunBtn.MouseButton1Click:Connect(function()
		isWallRunActive = not isWallRunActive
		wallRunBtn.Text = isWallRunActive and "Wall Run: ON" or "Wall Run: OFF"
		wallRunBtn.BackgroundColor3 = isWallRunActive and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(220, 50, 50)
		if not isWallRunActive then isWallRunning = false; stopClimbAnimations() end
	end)

	glideBtn.MouseButton1Click:Connect(function()
		isGlideActive = not isGlideActive
		glideBtn.Text = isGlideActive and "Glide: ON" or "Glide: OFF"
		glideBtn.BackgroundColor3 = isGlideActive and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(220, 50, 50)
		if not isGlideActive then stopGliding() end
	end)

	-- Initialization of Exec Automations
	task.defer(function()
		if CFG.AutoAntiFlingOnExec then
			antiFlingBtn.Text = "Anti Fling: ON"
			antiFlingBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
			setAntiFlingState(true)
		end

		if CFG.AutoSprintOnExec then
			toggleSprint(true)
		end

		if CFG.AutoNoclipOnExec then
			setNoclipState(true)
		end
	end)

	-- Render Loop for Movement & Animations
	renderConn = RunService.RenderStepped:Connect(function()
		-- Wall run logic
		if isSprinting and isWallRunActive then
			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = {character}
			rayParams.FilterType = Enum.RaycastFilterType.Exclude

			local rayResult = workspace:Raycast(rootPart.Position, rootPart.CFrame.LookVector * 3.5, rayParams)
			if rayResult and rayResult.Instance and rayResult.Instance.CanCollide and math.abs(rayResult.Normal.Y) < 0.3 then
				if not isWallRunning then
					isWallRunning = true
					stopGliding()
					stopSafe(idleTrack)
					stopAllMovement()
					stopAirAnimations()
					if sprintClimbTrack then sprintClimbTrack:Play() end
				end
				rootPart.AssemblyLinearVelocity = Vector3.new(0, CFG.WallRunSpeed, 0)
				return
			end
		end

		if isWallRunning then
			isWallRunning = false
			humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
			stopClimbAnimations()
		end

		if isGliding then
			if (tick() - glideStartTime) > calculatedGlideDuration then
				stopGliding()
			else
				local moveDir = humanoid.MoveDirection
				local moveVel = moveDir * (CFG.SprintSpeed * CFG.GlideForwardMultiplier)
				linearVelocity.VectorVelocity = Vector3.new(moveVel.X, CFG.GlideFallSpeed, moveVel.Z)
				if moveDir.Magnitude > 0.1 then
					rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + Vector3.new(moveDir.X, 0, moveDir.Z).Unit)
				end
			end
		end

		-- Ground Movement and Animation Handling
		local state = humanoid:GetState()
		if state ~= Enum.HumanoidStateType.Freefall and state ~= Enum.HumanoidStateType.Jumping and not isWallRunning then
			isFalling = false
			isJumping = false
			
			if humanoid.MoveDirection.Magnitude > 0.1 then
				stopSafe(idleTrack)
				if isSprinting then
					stopSafe(walkTrack)
					playSafe(runTrack)
				else
					stopSafe(runTrack)
					playSafe(walkTrack)
				end
			else
				stopAllMovement()
				playSafe(idleTrack)
			end
		end

		if state == Enum.HumanoidStateType.Freefall and not isClimbing then
			if not isFalling then
				isFalling = true
				isJumping = false
				stopSafe(idleTrack)
				stopAllMovement()
				stopSafe(normalJumpTrack)
				stopSafe(sprintJumpTrack)
				if isSprinting then playSafe(sprintFallTrack) else playSafe(normalFallTrack) end
			end
			if isSprinting and isGlideActive and not isGliding and rootPart.AssemblyLinearVelocity.Y <= 2 then
				startGliding()
			end
		end
	end)

	humanoid.StateChanged:Connect(function(oldState, newState)
		if newState == Enum.HumanoidStateType.Jumping then
			isJumping = true; isFalling = false; stopGliding(); stopAll()
			if isSprinting then playSafe(sprintJumpTrack) else playSafe(normalJumpTrack) end
		elseif newState == Enum.HumanoidStateType.Landed then
			isJumping = false; isFalling = false; stopGliding(); stopAirAnimations()
		end
	end)

	playSafe(idleTrack)

	humanoid.Died:Connect(function()
		stopAll()
		stopGliding()
		setAntiFlingState(false)
		setNoclipState(false)
		if renderConn then renderConn:Disconnect() end
	end)
end

if player.Character then setupCustomAnimations(player.Character) end
player.CharacterAdded:Connect(setupCustomAnimations)
