local Players = game:GetService("Players")
local player = Players.LocalPlayer

local ANIMATIONS = {
	Idle = "rbxassetid://121480327509940",
	Walk = "rbxassetid://118959209918644", -- Restored walk asset
	Run = "rbxassetid://83394429685133",   
	Jump = "rbxassetid://656117878",
	Fall = "rbxassetid://656115606",
	Climb = "rbxassetid://656114359",
}

local function setupCustomAnimations(character)
	local humanoid = character:WaitForChild("Humanoid")
	local animator = humanoid:WaitForChild("Animator")

	-- Set stats
	local lockedSpeed = 43
	local lockedJumpPower = 80

	humanoid.WalkSpeed = lockedSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = lockedJumpPower

	humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if humanoid.WalkSpeed ~= lockedSpeed then
			humanoid.WalkSpeed = lockedSpeed
		end
	end)

	humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
		if humanoid.JumpPower ~= lockedJumpPower then
			humanoid.JumpPower = lockedJumpPower
		end
	end)

	-- Anti-Fling
	for _, part in ipairs(character:GetDescendants()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.CanCollide = false
		end
	end
	
	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") and descendant.Name ~= "HumanoidRootPart" then
			descendant.CanCollide = false
		end
	end)

	local function loadAnimation(assetId, priority, looped)
		local anim = Instance.new("Animation")
		anim.AnimationId = assetId
		local track = animator:LoadAnimation(anim)
		track.Priority = priority or Enum.AnimationPriority.Action
		track.Looped = looped ~= nil and looped or false
		return track, anim
	end

	local idleTrack, idleAnim = loadAnimation(ANIMATIONS.Idle, Enum.AnimationPriority.Idle, true)
	local walkTrack, walkAnim = loadAnimation(ANIMATIONS.Walk, Enum.AnimationPriority.Action, true)
	local runTrack, runAnim = loadAnimation(ANIMATIONS.Run, Enum.AnimationPriority.Action, true)
	local jumpTrack, jumpAnim = loadAnimation(ANIMATIONS.Jump, Enum.AnimationPriority.Action3, true)
	local fallTrack, fallAnim = loadAnimation(ANIMATIONS.Fall, Enum.AnimationPriority.Action3, true)
	local climbTrack, climbAnim = loadAnimation(ANIMATIONS.Climb, Enum.AnimationPriority.Action3, true)

	local isJumping = false
	local isFalling = false
	local isClimbing = false

	local function stopAllMovement()
		walkTrack:Stop()
		runTrack:Stop()
	end

	local function stopAll()
		idleTrack:Stop()
		stopAllMovement()
		jumpTrack:Stop()
		fallTrack:Stop()
		climbTrack:Stop()
	end

	-- Dynamically sync animation playback speed and switch between Walk and Run
	humanoid.Running:Connect(function(speed)
		if isJumping or isFalling or isClimbing then return end

		if speed > 0.5 then
			idleTrack:Stop()
			
			-- Scale playback speed directly relative to actual movement velocity
			local playSpeed = math.max(0.1, speed / 16)

			-- Use current speed (not max WalkSpeed) to differentiate walking vs running
			if speed > 20 then
				if walkTrack.IsPlaying then walkTrack:Stop() end
				if not runTrack.IsPlaying then
					runTrack:Play()
				end
				runTrack:AdjustSpeed(playSpeed)
			else
				if runTrack.IsPlaying then runTrack:Stop() end
				if not walkTrack.IsPlaying then
					walkTrack:Play()
				end
				walkTrack:AdjustSpeed(playSpeed)
			end
		else
			stopAllMovement()
			if not idleTrack.IsPlaying then
				idleTrack:Play()
			end
		end
	end)

	humanoid.Climbing:Connect(function(climbSpeed)
		if isClimbing then
			if climbSpeed > 0.1 then
				if not climbTrack.IsPlaying then
					climbTrack:Play()
				end
				climbTrack:AdjustSpeed(1)
			else
				if climbTrack.IsPlaying then
					climbTrack:AdjustSpeed(0)
				end
			end
		end
	end)

	humanoid.StateChanged:Connect(function(oldState, newState)
		if newState == Enum.HumanoidStateType.Jumping then
			isJumping = true
			isFalling = false
			isClimbing = false
			stopAll()
			jumpTrack:Play()

		elseif newState == Enum.HumanoidStateType.Freefall then
			isJumping = false
			isFalling = true
			isClimbing = false
			stopAll()
			fallTrack:Play()

		elseif newState == Enum.HumanoidStateType.Landed then
			if isFalling or isJumping then
				isJumping = false
				isFalling = false
				isClimbing = false
				stopAll()
				
				local currentSpeed = humanoid.RootPart and humanoid.RootPart.AssemblyLinearVelocity.Magnitude or 0
				if humanoid.MoveDirection.Magnitude > 0 then
					if currentSpeed > 20 then
						runTrack:Play()
						runTrack:AdjustSpeed(currentSpeed / 16)
					else
						walkTrack:Play()
						walkTrack:AdjustSpeed(currentSpeed / 16)
					end
				else
					idleTrack:Play()
				end
			end

		elseif newState == Enum.HumanoidStateType.Climbing then
			isClimbing = true
			isJumping = false
			isFalling = false
			stopAll()
			climbTrack:Play()
			climbTrack:AdjustSpeed(1)

		elseif oldState == Enum.HumanoidStateType.Climbing then
			isClimbing = false
			climbTrack:AdjustSpeed(1)
			climbTrack:Stop()
			
			local currentSpeed = humanoid.RootPart and humanoid.RootPart.AssemblyLinearVelocity.Magnitude or 0
			if humanoid.MoveDirection.Magnitude > 0 then
				if currentSpeed > 20 then
					runTrack:Play()
					runTrack:AdjustSpeed(currentSpeed / 16)
				else
					walkTrack:Play()
					walkTrack:AdjustSpeed(currentSpeed / 16)
				end
			else
				idleTrack:Play()
			end
		end
	end)

	idleTrack:Play()

	humanoid.Died:Connect(function()
		stopAll()
		idleAnim:Destroy()
		walkAnim:Destroy()
		runAnim:Destroy()
		jumpAnim:Destroy()
		fallAnim:Destroy()
		climbAnim:Destroy()
	end)
end

if player.Character then
	setupCustomAnimations(player.Character)
end

player.CharacterAdded:Connect(setupCustomAnimations)
