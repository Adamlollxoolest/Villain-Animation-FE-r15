local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")
local camera = Workspace.CurrentCamera

-- ==========================================
-- DEFAULT CFG (CONFIGURATION)
-- ==========================================
local CFG = {
	WalkSpeed = 16,
	SprintSpeed = 235,
	WallRunSpeed = 200,
	JumpPower = 80,
	
	-- Glide Settings
	BaseGlideDuration = 1.0,     -- Base duration in seconds
	HeightBonusFactor = 0.05,    -- Extra duration added per stud of altitude
	MaxGlideDuration = 10.0,     -- Cap for max glide duration
	GlideFallSpeed = -5,         -- Float descent speed (gentle glide)
	GlideForwardMultiplier = 1.2, -- Speed multiplier while gliding forward

	-- Execution & Trigger Automation Flags
	AutoAntiFlingOnExec = false,
	AutoSprintOnExec = false,
	AutoGlideOnSprint = false,
	AutoWallRunOnSprint = false
}

local ANIMATIONS = {
	Idle = "rbxassetid://121480327509940",
	Walk = "rbxassetid://118959209918644",         -- Normal walk / Mahoraga Walk
	Run = "rbxassetid://83394429685133",           -- Super sprint
	NormalJump = "rbxassetid://656117878",         -- Ninja Jump (Sprint OFF)
	SprintJump = "rbxassetid://87628280298366",     -- Custom Jump (Sprint ON)
	NormalFall = "rbxassetid://656115606",         -- Ninja Fall (Sprint OFF)
	SprintFall = "rbxassetid://81030893339218",     -- Custom Fall (Sprint ON)
	NormalClimb = "rbxassetid://656114359",        -- Ninja Climb (Sprint OFF)
	SprintClimb = "rbxassetid://88763136693023",    -- Custom Climb & Wall Run
}

-- Mobile UI Setup (Positioned North-West / Top-Left)
local function createMobileUI()
	local existingGui = playerGui:FindFirstChild("MobileControlGui")
	if existingGui then existingGui:Destroy() end

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "MobileControlGui"
	screenGui.ResetOnSpawn = false
	screenGui.Parent = playerGui

	local function makeButton(name, text, position, color)
		local button = Instance.new("TextButton")
		button.Name = name
		button.Size = UDim2.new(0, 130, 0, 45)
		button.Position = position
		button.BackgroundColor3 = color
		button.TextColor3 = Color3.fromRGB(255, 255, 255)
		button.TextScaled = true
		button.Font = Enum.Font.SourceSansBold
		button.Text = text
		button.Active = true
		button.Draggable = true
		button.Parent = screenGui

		local uiCorner = Instance.new("UICorner")
		uiCorner.CornerRadius = UDim.new(0, 10)
		uiCorner.Parent = button

		return button
	end

	local sprintBtn = makeButton("SprintButton", "Sprint: OFF", UDim2.new(0, 20, 0, 20), Color3.fromRGB(220, 50, 50))
	local antiFlingBtn = makeButton("AntiFlingButton", "Anti Fling: OFF", UDim2.new(0, 20, 0, 70), Color3.fromRGB(220, 50, 50))
	local wallRunBtn = makeButton("WallRunButton", "Wall Run: OFF", UDim2.new(0, 20, 0, 120), Color3.fromRGB(220, 50, 50))
	local glideBtn = makeButton("GlideButton", "Glide: OFF", UDim2.new(0, 20, 0, 170), Color3.fromRGB(220, 50, 50))
	local cfgBtn = makeButton("CFGButton", "CFG Menu", UDim2.new(0, 20, 0, 220), Color3.fromRGB(100, 100, 100))
	
	-- CFG Frame
	local cfgFrame = Instance.new("Frame")
	cfgFrame.Name = "CFGFrame"
	cfgFrame.Size = UDim2.new(0, 280, 0, 360)
	cfgFrame.Position = UDim2.new(0, 160, 0, 20)
	cfgFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
	cfgFrame.Visible = false
	cfgFrame.Active = true
	cfgFrame.Parent = screenGui
	
	local frameCorner = Instance.new("UICorner")
	frameCorner.CornerRadius = UDim.new(0, 10)
	frameCorner.Parent = cfgFrame

	-- Dragging Logic for CFG Frame
	local dragging = false
	local dragInput = nil
	local dragStart = nil
	local startPos = nil

	local function updateDrag(input)
		local delta = input.Position - dragStart
		cfgFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	end

	cfgFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = cfgFrame.Position

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	cfgFrame.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if input == dragInput and dragging then
			updateDrag(input)
		end
	end)

	local function createCFGInput(labelText, defaultVal, posY, callback)
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0, 170, 0, 30)
		label.Position = UDim2.new(0, 10, 0, posY)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.Text = labelText
		label.Font = Enum.Font.SourceSans
		label.TextSize = 14
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = cfgFrame

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(0, 80, 0, 30)
		box.Position = UDim2.new(0, 190, 0, posY)
		box.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
		box.TextColor3 = Color3.fromRGB(255, 255, 255)
		box.Text = tostring(defaultVal)
		box.Font = Enum.Font.SourceSansBold
		box.TextSize = 14
		box.Parent = cfgFrame

		local boxCorner = Instance.new("UICorner")
		boxCorner.CornerRadius = UDim.new(0, 6)
		boxCorner.Parent = box

		local function updateValue()
			local num = tonumber(box.Text)
			if num then
				callback(num)
			else
				box.Text = tostring(defaultVal)
			end
		end

		box.FocusLost:Connect(updateValue)
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local num = tonumber(box.Text)
			if num then
				callback(num)
			end
		end)
	end

	-- Custom Toggle/Slider UI Component for Auto-Settings
	local function createCFGToggle(labelText, defaultState, posY, callback)
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0, 190, 0, 30)
		label.Position = UDim2.new(0, 10, 0, posY)
		label.BackgroundTransparency = 1
		label.TextColor3 = Color3.fromRGB(255, 255, 255)
		label.Text = labelText
		label.Font = Enum.Font.SourceSans
		label.TextSize = 14
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = cfgFrame

		local toggleBg = Instance.new("TextButton")
		toggleBg.Size = UDim2.new(0, 60, 0, 26)
		toggleBg.Position = UDim2.new(0, 200, 0, posY + 2)
		toggleBg.BackgroundColor3 = defaultState and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(80, 80, 80)
		toggleBg.Text = ""
		toggleBg.Parent = cfgFrame

		local bgCorner = Instance.new("UICorner")
		bgCorner.CornerRadius = UDim.new(1, 0)
		bgCorner.Parent = toggleBg

		local sliderKnob = Instance.new("Frame")
		sliderKnob.Size = UDim2.new(0, 22, 0, 22)
		sliderKnob.Position = defaultState and UDim2.new(1, -24, 0, 2) or UDim2.new(0, 2, 0, 2)
		sliderKnob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		sliderKnob.Parent = toggleBg

		local knobCorner = Instance.new("UICorner")
		knobCorner.CornerRadius = UDim.new(1, 0)
		knobCorner.Parent = sliderKnob

		local state = defaultState

		toggleBg.MouseButton1Click:Connect(function()
			state = not state
			if state then
				toggleBg.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
				sliderKnob.Position = UDim2.new(1, -24, 0, 2)
			else
				toggleBg.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
				sliderKnob.Position = UDim2.new(0, 2, 0, 2)
			end
			callback(state)
		end)
	end

	-- Textbox Inputs
	createCFGInput("Sprint Speed:", CFG.SprintSpeed, 10, function(val) CFG.SprintSpeed = val end)
	createCFGInput("Jump Power:", CFG.JumpPower, 45, function(val) 
		CFG.JumpPower = val
		if player.Character and player.Character:FindFirstChild("Humanoid") then
			player.Character.Humanoid.JumpPower = val
		end
	end)
	createCFGInput("Wall Speed:", CFG.WallRunSpeed, 80, function(val) CFG.WallRunSpeed = val end)
	createCFGInput("Glide Base (s):", CFG.BaseGlideDuration, 115, function(val) CFG.BaseGlideDuration = val end)
	createCFGInput("Glide Max (s):", CFG.MaxGlideDuration, 150, function(val) CFG.MaxGlideDuration = val end)

	-- Toggles / Sliders
	createCFGToggle("Anti Fling (Exec On):", CFG.AutoAntiFlingOnExec, 190, function(state) CFG.AutoAntiFlingOnExec = state end)
	createCFGToggle("Sprint (Exec On):", CFG.AutoSprintOnExec, 225, function(state) CFG.AutoSprintOnExec = state end)
	createCFGToggle("Glide (On Sprint):", CFG.AutoGlideOnSprint, 260, function(state) CFG.AutoGlideOnSprint = state end)
	createCFGToggle("Wall Run (On Sprint):", CFG.AutoWallRunOnSprint, 295, function(state) CFG.AutoWallRunOnSprint = state end)

	cfgBtn.MouseButton1Click:Connect(function()
		cfgFrame.Visible = not cfgFrame.Visible
	end)

	wallRunBtn.Visible = false
	glideBtn.Visible = false

	return sprintBtn, antiFlingBtn, wallRunBtn, glideBtn
end

local function setupCustomAnimations(character)
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")
	local animator = humanoid:WaitForChild("Animator")

	local defaultAnimateScript = character:FindFirstChild("Animate")
	if defaultAnimateScript then
		defaultAnimateScript.Disabled = true
	end

	humanoid.WalkSpeed = CFG.WalkSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = CFG.JumpPower

	humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
		if humanoid.JumpPower ~= CFG.JumpPower then
			humanoid.JumpPower = CFG.JumpPower
		end
	end)

	local function loadAnimation(name, assetId, priority, looped)
		local anim = Instance.new("Animation")
		anim.AnimationId = assetId
		
		local success, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		
		if not success or not track then
			warn("[Animation Error] Failed to load '" .. name .. "' (" .. assetId .. ").")
			return nil, anim
		end

		track.Priority = priority or Enum.AnimationPriority.Action
		track.Looped = looped ~= nil and looped or false
		return track, anim
	end

	local idleTrack, idleAnim = loadAnimation("Idle", ANIMATIONS.Idle, Enum.AnimationPriority.Idle, true)
	local walkTrack, walkAnim = loadAnimation("Walk", ANIMATIONS.Walk, Enum.AnimationPriority.Action2, true)
	local runTrack, runAnim = loadAnimation("Run", ANIMATIONS.Run, Enum.AnimationPriority.Action4, true)
	
	local normalJumpTrack, normalJumpAnim = loadAnimation("NormalJump", ANIMATIONS.NormalJump, Enum.AnimationPriority.Action4, false)
	local sprintJumpTrack, sprintJumpAnim = loadAnimation("SprintJump", ANIMATIONS.SprintJump, Enum.AnimationPriority.Action4, false)
	local normalFallTrack, normalFallAnim = loadAnimation("NormalFall", ANIMATIONS.NormalFall, Enum.AnimationPriority.Action4, true)
	local sprintFallTrack, sprintFallAnim = loadAnimation("SprintFall", ANIMATIONS.SprintFall, Enum.AnimationPriority.Action4, true)
	
	local normalClimbTrack, normalClimbAnim = loadAnimation("NormalClimb", ANIMATIONS.NormalClimb, Enum.AnimationPriority.Action3, true)
	local sprintClimbTrack, sprintClimbAnim = loadAnimation("SprintClimb", ANIMATIONS.SprintClimb, Enum.AnimationPriority.Action4, true)

	local isJumping = false
	local isFalling = false
	local isClimbing = false
	local isSprinting = false
	local isWallRunning = false
	local isWallRunActive = false
	local isGlideActive = false
	local isGliding = false
	local isAntiFlingActive = false
	
	local glideStartTime = 0
	local calculatedGlideDuration = CFG.BaseGlideDuration
	local linearVelocity = nil
	local glideAttachment = nil

	local antiFlingConn = nil
	local renderConn = nil

	-- Persistent Trail Objects
	local att0 = Instance.new("Attachment")
	att0.Position = Vector3.new(0, 1, 0)
	att0.Name = "GlideTrailAtt0"
	att0.Parent = rootPart

	local att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, -1, 0)
	att1.Name = "GlideTrailAtt1"
	att1.Parent = rootPart

	local persistentTrail = Instance.new("Trail")
	persistentTrail.Attachment0 = att0
	persistentTrail.Attachment1 = att1
	persistentTrail.Lifetime = 0.5
	persistentTrail.MinLength = 0.05
	persistentTrail.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 255, 255))
	persistentTrail.Transparency = NumberSequence.new(0.05, 1)
	persistentTrail.LightEmission = 1
	persistentTrail.Enabled = false
	persistentTrail.Parent = rootPart

	local function playSafe(track)
		if track then
			track.TimePosition = 0
			if not track.IsPlaying then
				track:Play()
			end
		end
	end

	local function stopSafe(track)
		if track and track.IsPlaying then
			track:Stop()
		end
	end

	local function stopAllMovement()
		stopSafe(walkTrack)
		stopSafe(runTrack)
	end

	local function stopAirAnimations()
		stopSafe(normalJumpTrack)
		stopSafe(sprintJumpTrack)
		stopSafe(normalFallTrack)
		stopSafe(sprintFallTrack)
	end

	local function stopClimbAnimations()
		stopSafe(normalClimbTrack)
		stopSafe(sprintClimbTrack)
	end

	local function stopAll()
		stopSafe(idleTrack)
		stopAllMovement()
		stopAirAnimations()
		stopClimbAnimations()
		
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			if track ~= idleTrack and track ~= walkTrack and track ~= runTrack 
			   and track ~= normalJumpTrack and track ~= sprintJumpTrack 
			   and track ~= normalFallTrack and track ~= sprintFallTrack 
			   and track ~= normalClimbTrack and track ~= sprintClimbTrack then
				track:Stop()
			end
		end
	end

	local function applySafetyBrake()
		if rootPart then
			rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
		end
	end

	local function stopGliding()
		isGliding = false
		persistentTrail.Enabled = false
		
		if linearVelocity then
			linearVelocity:Destroy()
			linearVelocity = nil
		end
		if glideAttachment then
			glideAttachment:Destroy()
			glideAttachment = nil
		end
	end

	local function startGliding()
		if isGliding or not isSprinting or not isGlideActive then return end
		
		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {character}
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -500, 0), rayParams)
		local groundHeight = rayResult and (rootPart.Position.Y - rayResult.Position.Y) or 0
		
		calculatedGlideDuration = math.min(
			CFG.BaseGlideDuration + (groundHeight * CFG.HeightBonusFactor), 
			CFG.MaxGlideDuration
		)
		
		isGliding = true
		glideStartTime = tick()

		if not glideAttachment then
			glideAttachment = Instance.new("Attachment")
			glideAttachment.Name = "GlideAttachment"
			glideAttachment.Parent = rootPart
		end

		if not linearVelocity then
			linearVelocity = Instance.new("LinearVelocity")
			linearVelocity.Attachment0 = glideAttachment
			linearVelocity.MaxForce = 500000
			linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
			linearVelocity.Parent = rootPart
		end

		persistentTrail.Enabled = true
	end

	local function setAntiFlingState(enable)
		isAntiFlingActive = enable
		
		if antiFlingConn then
			antiFlingConn:Disconnect()
			antiFlingConn = nil
		end

		if isAntiFlingActive then
			antiFlingConn = RunService.Stepped:Connect(function()
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end)
		else
			for _, part in ipairs(character:GetDescendants()) do
				if part:IsA("BasePart") then
					if part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" then
						part.CanCollide = true
					else
						part.CanCollide = false
					end
				end
			end
		end
	end

	local function updateMovementAnimation()
		if isJumping or isFalling or isClimbing or isWallRunning or isGliding then return end

		if humanoid.MoveDirection.Magnitude > 0.05 then
			stopSafe(idleTrack)
			
			if isSprinting then
				stopSafe(walkTrack)
				if runTrack then
					if not runTrack.IsPlaying then
						runTrack.TimePosition = 0
						runTrack:Play()
					end
					runTrack:AdjustSpeed(2.5)
				end
			else
				stopSafe(runTrack)
				if walkTrack then
					if not walkTrack.IsPlaying then
						walkTrack.TimePosition = 0
						walkTrack:Play()
					end
					walkTrack:AdjustSpeed(1)
				end
			end
		else
			stopAllMovement()
			applySafetyBrake()
			playSafe(idleTrack)
		end
	end

	-- Raycast Wall Run Logic
	local function updateWallRun()
		if not isSprinting or not isWallRunActive then
			if isWallRunning then
				isWallRunning = false
				humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
				stopClimbAnimations()
				updateMovementAnimation()
			end
			return
		end

		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {character}
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local lookVector = rootPart.CFrame.LookVector
		local rayResult = workspace:Raycast(rootPart.Position, lookVector * 3.5, rayParams)

		if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
			if math.abs(rayResult.Normal.Y) < 0.3 then
				if not isWallRunning then
					isWallRunning = true
					isJumping = false
					isFalling = false
					stopGliding()
					
					stopSafe(idleTrack)
					stopAllMovement()
					stopAirAnimations()
					stopSafe(normalClimbTrack)

					if sprintClimbTrack then
						sprintClimbTrack.TimePosition = 0
						sprintClimbTrack:Play()
					end
				end

				if humanoid.MoveDirection.Magnitude > 0.05 then
					rootPart.AssemblyLinearVelocity = Vector3.new(0, CFG.WallRunSpeed, 0)
					if sprintClimbTrack then
						sprintClimbTrack:AdjustSpeed(2.5)
					end
				else
					rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
					if sprintClimbTrack then
						sprintClimbTrack:AdjustSpeed(0)
					end
				end
				return
			end
		end

		if isWallRunning then
			isWallRunning = false
			humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
			stopClimbAnimations()
			updateMovementAnimation()
		end
	end

	local sprintBtn, antiFlingBtn, wallRunBtn, glideBtn = createMobileUI()
	local sprintConn, antiFlingBtnConn, wallRunBtnConn, glideBtnConn

	local function toggleSprint(enable)
		isSprinting = enable
		humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
		wallRunBtn.Visible = isSprinting
		glideBtn.Visible = isSprinting

		if isSprinting then
			sprintBtn.Text = "Sprint: ON"
			sprintBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
			
			if CFG.AutoGlideOnSprint then
				isGlideActive = true
				glideBtn.Text = "Glide: ON"
				glideBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
			end
			
			if CFG.AutoWallRunOnSprint then
				isWallRunActive = true
				wallRunBtn.Text = "Wall Run: ON"
				wallRunBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
			end
		else
			sprintBtn.Text = "Sprint: OFF"
			sprintBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			
			isWallRunActive = false
			isWallRunning = false
			isGlideActive = false
			stopGliding()
			
			wallRunBtn.Text = "Wall Run: OFF"
			wallRunBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			
			glideBtn.Text = "Glide: OFF"
			glideBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			
			stopClimbAnimations()
		end
		
		stopAllMovement()
		updateMovementAnimation()
	end

	humanoid:GetPropertyChangedSignal("MoveDirection"):Connect(function()
		updateMovementAnimation()
	end)

	-- PC Inputs
	local inputBeganConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode == Enum.KeyCode.LeftShift then
			toggleSprint(true)
		end
	end)

	local inputEndedConn = UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then
			toggleSprint(false)
		end
	end)

	-- Mobile Controls
	sprintConn = sprintBtn.MouseButton1Click:Connect(function()
		toggleSprint(not isSprinting)
	end)

	antiFlingBtnConn = antiFlingBtn.MouseButton1Click:Connect(function()
		if isAntiFlingActive then
			antiFlingBtn.Text = "Anti Fling: OFF"
			antiFlingBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			setAntiFlingState(false)
		else
			antiFlingBtn.Text = "Anti Fling: ON"
			antiFlingBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
			setAntiFlingState(true)
		end
	end)

	wallRunBtnConn = wallRunBtn.MouseButton1Click:Connect(function()
		if isWallRunActive then
			isWallRunActive = false
			isWallRunning = false
			humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
			wallRunBtn.Text = "Wall Run: OFF"
			wallRunBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			stopClimbAnimations()
			updateMovementAnimation()
		else
			isWallRunActive = true
			wallRunBtn.Text = "Wall Run: ON"
			wallRunBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		end
	end)

	glideBtnConn = glideBtn.MouseButton1Click:Connect(function()
		if isGlideActive then
			isGlideActive = false
			stopGliding()
			glideBtn.Text = "Glide: OFF"
			glideBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
		else
			isGlideActive = true
			glideBtn.Text = "Glide: ON"
			glideBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		end
	end)

	-- Initialize Execution-based Toggles
	if CFG.AutoAntiFlingOnExec then
		antiFlingBtn.Text = "Anti Fling: ON"
		antiFlingBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		setAntiFlingState(true)
	end

	if CFG.AutoSprintOnExec then
		toggleSprint(true)
	end

	-- Render Loop
	renderConn = RunService.RenderStepped:Connect(function()
		updateWallRun()

		if isWallRunning then return end

		-- Modern Velocity Glide Management
		if isGliding then
			if (tick() - glideStartTime) > calculatedGlideDuration then
				stopGliding()
			else
				local moveDir = humanoid.MoveDirection
				local moveVel = moveDir * (CFG.SprintSpeed * CFG.GlideForwardMultiplier)
				linearVelocity.VectorVelocity = Vector3.new(moveVel.X, CFG.GlideFallSpeed, moveVel.Z)

				if moveDir.Magnitude > 0.1 then
					local flatLookVector = Vector3.new(moveDir.X, 0, moveDir.Z).Unit
					rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + flatLookVector)
				end
			end
		end

		local state = humanoid:GetState()
		if state == Enum.HumanoidStateType.Freefall and not isClimbing then
			if not isFalling then
				isFalling = true
				isJumping = false
				stopSafe(idleTrack)
				stopAllMovement()
				stopSafe(normalJumpTrack)
				stopSafe(sprintJumpTrack)

				if isSprinting then
					stopSafe(normalFallTrack)
					playSafe(sprintFallTrack)
				else
					stopSafe(sprintFallTrack)
					playSafe(normalFallTrack)
				end
			end
			
			if isSprinting and isGlideActive and not isGliding and rootPart.AssemblyLinearVelocity.Y <= 2 then
				startGliding()
			end
		end
	end)

	-- Standard Climbing
	humanoid.Climbing:Connect(function(climbSpeed)
		if isClimbing and not isWallRunning then
			stopGliding()
			local activeTrack = isSprinting and sprintClimbTrack or normalClimbTrack
			local inactiveTrack = isSprinting and normalClimbTrack or sprintClimbTrack
			
			stopSafe(inactiveTrack)
			
			if climbSpeed > 0.1 then
				playSafe(activeTrack)
				if activeTrack then activeTrack:AdjustSpeed(1) end
			else
				if activeTrack and activeTrack.IsPlaying then activeTrack:AdjustSpeed(0) end
			end
		end
	end)

	humanoid.StateChanged:Connect(function(oldState, newState)
		if newState == Enum.HumanoidStateType.Jumping then
			isJumping = true
			isFalling = false
			isClimbing = false
			isWallRunning = false
			stopGliding()
			
			stopSafe(idleTrack)
			stopAllMovement()
			stopClimbAnimations()
			stopSafe(normalFallTrack)
			stopSafe(sprintFallTrack)

			if isSprinting then
				stopSafe(normalJumpTrack)
				playSafe(sprintJumpTrack)
			else
				stopSafe(sprintJumpTrack)
				playSafe(normalJumpTrack)
			end

		elseif newState == Enum.HumanoidStateType.Landed then
			isJumping = false
			isFalling = false
			isClimbing = false
			isWallRunning = false
			stopGliding()
			stopAirAnimations()
			stopClimbAnimations()
			updateMovementAnimation()

		elseif newState == Enum.HumanoidStateType.Climbing then
			isClimbing = true
			isJumping = false
			isFalling = false
			stopGliding()
			stopSafe(idleTrack)
			stopAllMovement()
			stopAirAnimations()
			
			if isSprinting then
				stopSafe(normalClimbTrack)
				playSafe(sprintClimbTrack)
				if sprintClimbTrack then sprintClimbTrack:AdjustSpeed(1) end
			else
				stopSafe(sprintClimbTrack)
				playSafe(normalClimbTrack)
				if normalClimbTrack then normalClimbTrack:AdjustSpeed(1) end
			end

		elseif oldState == Enum.HumanoidStateType.Climbing then
			isClimbing = false
			stopClimbAnimations()
			updateMovementAnimation()
		end
	end)

	playSafe(idleTrack)

	humanoid.Died:Connect(function()
		stopAll()
		stopGliding()
		setAntiFlingState(false)
		if persistentTrail then persistentTrail:Destroy() end
		if att0 then att0:Destroy() end
		if att1 then att1:Destroy() end
		if renderConn then renderConn:Disconnect() end
		if inputBeganConn then inputBeganConn:Disconnect() end
		if inputEndedConn then inputEndedConn:Disconnect() end
		if sprintConn then sprintConn:Disconnect() end
		if antiFlingBtnConn then antiFlingBtnConn:Disconnect() end
		if wallRunBtnConn then wallRunBtnConn:Disconnect() end
		if glideBtnConn then glideBtnConn:Disconnect() end
		idleAnim:Destroy()
		walkAnim:Destroy()
		runAnim:Destroy()
		normalJumpAnim:Destroy()
		sprintJumpAnim:Destroy()
		normalFallAnim:Destroy()
		sprintFallAnim:Destroy()
		normalClimbAnim:Destroy()
		sprintClimbAnim:Destroy()
	end)
end

if player.Character then
	setupCustomAnimations(player.Character)
end

player.CharacterAdded:Connect(setupCustomAnimations)
