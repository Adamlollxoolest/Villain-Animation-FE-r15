	local function isHeadInWater()
		local terrain = workspace.Terrain
		if not terrain then return false end

		local headPos = headPart.Position
		local region = Region3.new(headPos - Vector3.new(0.5, 0.5, 0.5), headPos + Vector3.new(0.5, 0.5, 0.5))
		region = region:ExpandToGrid(4)

		local materials = terrain:ReadVoxels(region, 4)
		for x = 1, materials.Size.X do
			for y = 1, materials.Size.Y do
				for z = 1, materials.Size.Z do
					if materials[x][y][z] == Enum.Material.Water then
						return true
					end
				end
			end
		end

		local rayParams = RaycastParams.new()
		local filterInstances = {character}
		if waterPlatform then table.insert(filterInstances, waterPlatform) end
		rayParams.FilterDescendantsInstances = filterInstances
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.IgnoreWater = false

		local rayResult = workspace:Raycast(headPos + Vector3.new(0, 2, 0), Vector3.new(0, -2.5, 0), rayParams)
		if rayResult and (rayResult.Material == Enum.Material.Water or string.find(string.lower(rayResult.Instance.Name), "water")) then
			return true
		end

		return false
	end

	renderConn = RunService.RenderStepped:Connect(function()
		if isFlying then return end

		local state = humanoid:GetState()

		if state == Enum.HumanoidStateType.GettingUp or state == Enum.HumanoidStateType.Seated then
			return
		end

		if (state == Enum.HumanoidStateType.Landed or isGrounded()) and rootPart.AssemblyLinearVelocity.Y < -30 then
			local curVel = rootPart.AssemblyLinearVelocity
			rootPart.AssemblyLinearVelocity = Vector3.new(curVel.X, 0, curVel.Z)
		end

		if CFG.SlowFallingActive and not isGliding and (state == Enum.HumanoidStateType.Freefall or rootPart.AssemblyLinearVelocity.Y < -1) and not isGrounded() then
			local curVel = rootPart.AssemblyLinearVelocity
			if curVel.Y < CFG.SlowFallingFallSpeed then
				rootPart.AssemblyLinearVelocity = Vector3.new(curVel.X, CFG.SlowFallingFallSpeed, curVel.Z)
			end
		end

		if isSprinting and isWalkOnWaterActive then
			local rayParams = RaycastParams.new()
			local filterInstances = {character}
			if waterPlatform then table.insert(filterInstances, waterPlatform) end
			rayParams.FilterDescendantsInstances = filterInstances
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			rayParams.IgnoreWater = false

			local rayOrigin = rootPart.Position + Vector3.new(0, 5, 0)
			local rayResult = workspace:Raycast(rayOrigin, Vector3.new(0, -35, 0), rayParams)
			
			if rayResult and (rayResult.Material == Enum.Material.Water or string.find(string.lower(rayResult.Instance.Name), "water")) then
				local surfaceY = rayResult.Position.Y
				local isUnderwater = headPart.Position.Y < (surfaceY - 0.5) or isHeadInWater()

				if isUnderwater then
					isWalkingOnWater = false
					if waterPlatform then waterPlatform.CanCollide = false end
				else
					isWalkingOnWater = true
					stopGliding()

					if state == Enum.HumanoidStateType.Swimming or state == Enum.HumanoidStateType.Freefall then
						humanoid:ChangeState(Enum.HumanoidStateType.Running)
					end

					if waterPlatform then
						waterPlatform.CFrame = CFrame.new(rootPart.Position.X, surfaceY - (waterPlatform.Size.Y / 2) + CFG.WalkOnWaterHeightOffset, rootPart.Position.Z)
						waterPlatform.CanCollide = true
					end
					
					if tick() > waterJumpCooldown and rootPart.Position.Y < surfaceY + 1 then
						rootPart.CFrame = CFrame.new(rootPart.Position.X, surfaceY + 3, rootPart.Position.Z)
						rootPart.AssemblyLinearVelocity = Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z)
					end
				end
			else
				isWalkingOnWater = false
				if waterPlatform then waterPlatform.CanCollide = false end
			end
		else
			isWalkingOnWater = false
			if waterPlatform then waterPlatform.CanCollide = false end
		end

		if state == Enum.HumanoidStateType.Swimming and not (isSprinting and isWalkOnWaterActive) then
			isWalkingOnWater = false
			if waterPlatform then waterPlatform.CanCollide = false end
			isGliding = false
			persistentTrail.Enabled = false

			local isMoving = humanoid.MoveDirection.Magnitude > 0.1
			if isMoving then
				playMovementTrack(swimTrack, 0)
			else
				if not isHeadInWater() then
					playMovementTrack(swimIdleTrack, 0)
				else
					playMovementTrack(swimTrack, 0)
				end
			end
			return
		end

		if state == Enum.HumanoidStateType.Climbing then
			isWalkingOnWater = false
			if waterPlatform then waterPlatform.CanCollide = false end
			isGliding = false
			persistentTrail.Enabled = false
			
			local activeClimbTrack = isSprinting and sprintClimbTrack or normalClimbTrack
			if activeClimbTrack then
				playMovementTrack(activeClimbTrack, 0.1)
				if math.abs(rootPart.AssemblyLinearVelocity.Y) > 0.1 then
					activeClimbTrack:AdjustSpeed(1)
				else
					activeClimbTrack:AdjustSpeed(0)
				end
			end
			return
		end

		if isSprinting and humanoid.MoveDirection.Magnitude > 0.1 then
			local rayParams = RaycastParams.new()
			local filterInstances = {character}
			if waterPlatform then table.insert(filterInstances, waterPlatform) end
			rayParams.FilterDescendantsInstances = filterInstances
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			local rayResult = workspace:Raycast(rootPart.Position, humanoid.MoveDirection * 3.5, rayParams)
			if rayResult and rayResult.Instance and rayResult.Instance.CanCollide and math.abs(rayResult.Normal.Y) < 0.3 then
				local currentVel = rootPart.AssemblyLinearVelocity
				rootPart.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
			end
		end

		local wallRayHit = false
		if isSprinting and isWallRunActive then
			local rayParams = RaycastParams.new()
			local filterInstances = {character}
			if waterPlatform then table.insert(filterInstances, waterPlatform) end
			rayParams.FilterDescendantsInstances = filterInstances
			rayParams.FilterType = Enum.RaycastFilterType.Exclude
			local rayResult = workspace:Raycast(rootPart.Position, rootPart.CFrame.LookVector * 3.5, rayParams)
			if rayResult and rayResult.Instance and rayResult.Instance.CanCollide and math.abs(rayResult.Normal.Y) < 0.3 then
				wallRayHit = true
				if not isWallRunning then
					isWallRunning = true
					stopGliding()
					stopAirAnimations()
					if sprintClimbTrack then 
						stopAllAnimationsExcept(sprintClimbTrack)
						sprintClimbTrack:Play(0.1) 
					end
				end

				local moveDir = humanoid.MoveDirection
				local lookVec = rootPart.CFrame.LookVector
				local moveDot = moveDir:Dot(lookVec)

				local targetYSpeed = 0
				if moveDir.Magnitude > 0.1 then
					if moveDot > 0.1 then
						targetYSpeed = CFG.WallRunSpeed
						if sprintClimbTrack then sprintClimbTrack:AdjustSpeed(1) end
					elseif moveDot < -0.1 then
						targetYSpeed = -CFG.WallRunSpeed * 0.5
						if sprintClimbTrack then sprintClimbTrack:AdjustSpeed(1) end
					else
						targetYSpeed = 0
						if sprintClimbTrack then sprintClimbTrack:AdjustSpeed(0) end
					end
				else
					targetYSpeed = 0
					if sprintClimbTrack then sprintClimbTrack:AdjustSpeed(0) end
				end

				rootPart.AssemblyLinearVelocity = Vector3.new(0, targetYSpeed, 0)
				return
			end
		end

		if isWallRunning and not wallRayHit then
			detachFromWall()
		end

		if isGliding then
			if (tick() - glideStartTime) > calculatedGlideDuration then
				stopGliding()
			else
				local moveDir = humanoid.MoveDirection
				local moveVel = moveDir * (CFG.SprintSpeed * CFG.GlideForwardMultiplier)
				linearVelocity.VectorVelocity = Vector3.new(moveVel.X, CFG.GlideFallSpeed, moveVel.Z)
				if moveDir.Magnitude > 0.1 then
					rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + Vector3.new(moveDir.X, 0, moveDir.Z).Unit)
				end
			end
		end

		if humanoid.MoveDirection.Magnitude <= 0.1 and not isGliding and not isWalkingOnWater and (state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.RunningNoPhysics) then
			rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
		end

		if (state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.RunningNoPhysics or state == Enum.HumanoidStateType.Landed) and math.abs(rootPart.AssemblyLinearVelocity.Y) < 1.5 then
			isJumping = false
			isFalling = false
		end

		if (state ~= Enum.HumanoidStateType.Freefall and state ~= Enum.HumanoidStateType.Jumping and state ~= Enum.HumanoidStateType.Swimming and state ~= Enum.HumanoidStateType.Climbing and state ~= Enum.HumanoidStateType.Seated and not isWallRunning and not isJumping and not isFalling) or isWalkingOnWater then
			if humanoid.MoveDirection.Magnitude > 0.1 then
				playMovementTrack(isSprinting and runTrack or walkTrack, 0.1)
			else
				playMovementTrack(idleTrack, 0.1)
			end
		end

		if (state == Enum.HumanoidStateType.Freefall or rootPart.AssemblyLinearVelocity.Y < -5) and not isWalkingOnWater and not isGrounded() then
			if not isFalling then
				isFalling = true
				isJumping = false
				stopAirAnimations()
				if isSprinting and sprintFallTrack then 
					stopAllAnimationsExcept(sprintFallTrack)
					sprintFallTrack:Play(0.1)
				elseif normalFallTrack then 
					stopAllAnimationsExcept(normalFallTrack)
					normalFallTrack:Play(0.1) 
				end
			end
			if isSprinting and isGlideActive and not isGliding and rootPart.AssemblyLinearVelocity.Y <= 2 then
				startGliding()
			end
		end
	end)

	humanoid.StateChanged:Connect(function(oldState, newState)
		if isFlying then return end

		if newState == Enum.HumanoidStateType.Seated then
			stopGliding()
			isWalkingOnWater = false
			if waterPlatform then waterPlatform.CanCollide = false end
			stopAirAnimations()
			playMovementTrack(sitTrack, 0.1)
		elseif newState == Enum.HumanoidStateType.Climbing then
			stopGliding()
			isWalkingOnWater = false
			if waterPlatform then waterPlatform.CanCollide = false end
			stopAirAnimations()
			playMovementTrack(isSprinting and sprintClimbTrack or normalClimbTrack, 0.1)
		elseif newState == Enum.HumanoidStateType.Swimming then
			if isSprinting and isWalkOnWaterActive and not isHeadInWater() then
				humanoid:ChangeState(Enum.HumanoidStateType.Running)
			else
				isWalkingOnWater = false
				if waterPlatform then waterPlatform.CanCollide = false end
				stopGliding()
				stopAirAnimations()
				if humanoid.MoveDirection.Magnitude > 0.1 then
					playMovementTrack(swimTrack, 0)
				else
					if not isHeadInWater() then
						playMovementTrack(swimIdleTrack, 0)
					else
						playMovementTrack(swimTrack, 0)
					end
				end
			end
		elseif newState == Enum.HumanoidStateType.Jumping then
			isJumping = true; isFalling = false; stopGliding(); isWalkingOnWater = false; if waterPlatform then waterPlatform.CanCollide = false end
			waterJumpCooldown = tick() + 0.5
			stopAirAnimations()
			if isSprinting and sprintJumpTrack then 
				stopAllAnimationsExcept(sprintJumpTrack)
				sprintJumpTrack:Play(0.1)
			elseif normalJumpTrack then 
				stopAllAnimationsExcept(normalJumpTrack)
				normalJumpTrack:Play(0.1) 
			end
		elseif newState == Enum.HumanoidStateType.Landed or newState == Enum.HumanoidStateType.Running then
			isJumping = false; isFalling = false; stopGliding(); stopAirAnimations()
			if humanoid.MoveDirection.Magnitude > 0.1 then
				playMovementTrack(isSprinting and runTrack or walkTrack, 0.1)
			else
				playMovementTrack(idleTrack, 0.1)
			end
		end
	end)

	playMovementTrack(idleTrack, 0.1)

	humanoid.Died:Connect(function()
		stopFlying()
		if speedLockConn then speedLockConn:Disconnect() end
		if jumpReqConn then jumpReqConn:Disconnect() end
		if healthGuardConn then healthGuardConn:Disconnect() end
		if healthChangedConn then healthChangedConn:Disconnect() end
		if waterPlatform then waterPlatform:Destroy() end
		stopGliding()
		setAntiFlingState(false)
		setNoclipState(false)
		if renderConn then renderConn:Disconnect() end
	end)
end

if player.Character then setupCustomAnimations(player.Character) end
player.CharacterAdded:Connect(setupCustomAnimations)
