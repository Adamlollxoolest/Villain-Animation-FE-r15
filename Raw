	local function applyColorValues(r, g, b)
		CFG.TrailColorR = math.clamp(math.floor(r), 0, 255)
		CFG.TrailColorG = math.clamp(math.floor(g), 0, 255)
		CFG.TrailColorB = math.clamp(math.floor(b), 0, 255)
		
		rgbBox.Text = string.format("%d,%d,%d", CFG.TrailColorR, CFG.TrailColorG, CFG.TrailColorB)
		hexBox.Text = string.format("#%02X%02X%02X", CFG.TrailColorR, CFG.TrailColorG, CFG.TrailColorB)
		
		updateTrailColorCallback(CFG.TrailColorR, CFG.TrailColorG, CFG.TrailColorB)
		saveCFG()
	end

