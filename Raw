	local function stopAllAnimationsExcept(targetTrack)
		for _, track in ipairs(allAnimationTracks) do
			if track and track ~= targetTrack and track.IsPlaying then
				track:Stop(0.1)
			end
		end
	end

	local function playMovementTrack(track, fadeTime)
		if not track then return end
		fadeTime = fadeTime or 0.1
		stopAllAnimationsExcept(track)
		if currentMovementTrack == track then
			if not track.IsPlaying then track:Play(fadeTime) end
			return
		end
		currentMovementTrack = track
		if not track.IsPlaying then track:Play(fadeTime) end
	end

	local function stopFlying()
		isFlying = false
		if flyConn then flyConn:Disconnect(); flyConn = nil end
		if velocityBypassConn then velocityBypassConn:Disconnect(); velocityBypassConn = nil end
		if flyBodyVel then flyBodyVel:Destroy(); flyBodyVel = nil end
		if flyBodyGyro then flyBodyGyro:Destroy(); flyBodyGyro = nil end
		
		if rootPart then
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end
		
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
		humanoid.PlatformStand = false
		
		if flyTrack and flyTrack.IsPlaying then flyTrack:Stop(0.1) end
		if flyIdleTrack and flyIdleTrack.IsPlaying then flyIdleTrack:Stop(0.1) end
	end

	local function startFlying()
		if isFlying then return end
		isFlying = true
		
		humanoid:SetStateEnabled(Enum.HumanoidStateType.Freefall, false)
		humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
		humanoid.PlatformStand = true

		flyBodyVel = Instance.new("BodyVelocity")
		flyBodyVel.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		flyBodyVel.Velocity = Vector3.zero
		flyBodyVel.Parent = rootPart

		flyBodyGyro = Instance.new("BodyGyro")
		flyBodyGyro.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
		flyBodyGyro.P = 10000
		flyBodyGyro.CFrame = rootPart.CFrame
		flyBodyGyro.Parent = rootPart

		local camera = Workspace.CurrentCamera

		velocityBypassConn = RunService.Heartbeat:Connect(function()
			if isFlying and rootPart then
				rootPart.AssemblyLinearVelocity = Vector3.zero
				rootPart.AssemblyAngularVelocity = Vector3.zero
			end
		end)

		local function getLocalMoveVector()
			local success, vec = pcall(function()
				local playerScripts = player:FindFirstChild("PlayerScripts")
				if playerScripts then
					local playerModule = playerScripts:FindFirstChild("PlayerModule")
					if playerModule then
						return require(playerModule):GetControls():GetMoveVector()
					end
				end
			end)
			if success and vec and vec.Magnitude > 0.01 then
				return vec
			end

			local moveDir = humanoid.MoveDirection
			if moveDir.Magnitude > 0.01 then
				local camCF = camera.CFrame
				local flatLook = Vector3.new(camCF.LookVector.X, 0, camCF.LookVector.Z)
				if flatLook.Magnitude > 0.001 then
					flatLook = flatLook.Unit
					local flatCF = CFrame.lookAt(Vector3.zero, flatLook)
					local localDir = flatCF:VectorToObjectSpace(moveDir)
					return Vector3.new(localDir.X, 0, localDir.Z)
				end
			end
			return Vector3.zero
		end

		flyConn = RunService.RenderStepped:Connect(function()
			if not isFlying or not rootPart then
				stopFlying()
				return
			end

			flyBodyGyro.CFrame = camera.CFrame

			local moveVec = getLocalMoveVector()
			if moveVec.Magnitude > 0.1 then
				local camCF = camera.CFrame
				local flyVector = (camCF.LookVector * -moveVec.Z) + (camCF.RightVector * moveVec.X)
				
				if flyVector.Magnitude > 0.01 then
					flyBodyVel.Velocity = flyVector.Unit * CFG.FlySpeed
					playMovementTrack(flyTrack, 0.1)
				else
					flyBodyVel.Velocity = Vector3.zero
					playMovementTrack(flyIdleTrack, 0.1)
				end
			else
				flyBodyVel.Velocity = Vector3.zero
				playMovementTrack(flyIdleTrack, 0.1)
			end
		end)
	end

	local function updateWaterPlatformExistence()
		if isWalkOnWaterActive and isSprinting then
			if not waterPlatform or not waterPlatform.Parent then
				waterPlatform = Instance.new("Part")
				waterPlatform.Name = "WaterPlatform"
				waterPlatform.Size = Vector3.new(16, 1.5, 16)
				waterPlatform.Anchored = true
				waterPlatform.Transparency = 1
				waterPlatform.CanCollide = true
				waterPlatform.Parent = workspace
			end
		else
			if waterPlatform then
				waterPlatform:Destroy()
				waterPlatform = nil
			end
			isWalkingOnWater = false
		end
	end

