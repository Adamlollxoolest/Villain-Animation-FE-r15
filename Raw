-- Absolute Destruction Handler for INF-HH Shiftlock
local function setShiftlockState(state)
	CFG.Shiftlock = state
	saveCFG()
	
	if state then
		local connections = {}
		
		local function trackContainer(container)
			table.insert(connections, container.DescendantAdded:Connect(function(descendant)
				if descendant ~= playerGui and descendant.Name ~= "TouchGui" and descendant.Name ~= "MobileControlGui" then
					table.insert(trackedINFHHItems, descendant)
				end
			end))
		end

		trackContainer(playerGui)
		pcall(function() trackContainer(CoreGui) end)

		pcall(function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/INF-HH/-/refs/heads/main/Script"))()
		end)

		task.delay(2.0, function()
			for _, conn in ipairs(connections) do
				pcall(function() conn:Disconnect() end)
			end
		end)
	else
		for _, item in ipairs(trackedINFHHItems) do
			if item and item.Parent then
				pcall(function() item:Destroy() end)
			end
		end
		trackedINFHHItems = {}

		pcall(function()
			for _, gui in ipairs(playerGui:GetChildren()) do
				if gui.Name ~= "MobileControlGui" and gui.Name ~= "TouchGui" then
					local nameLower = string.lower(gui.Name)
					if nameLower:find("shift") or nameLower:find("lock") or nameLower:find("inf") or nameLower:find("hh") or nameLower:find("gui") then
						gui:Destroy()
					end
				end
			end
		end)

		pcall(function()
			for _, gui in ipairs(CoreGui:GetChildren()) do
				local nameLower = string.lower(gui.Name)
				if nameLower:find("shift") or nameLower:find("lock") or nameLower:find("inf") or nameLower:find("hh") then
					gui:Destroy()
				end
			end
		end)
	end
end

