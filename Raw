	local function triggerJumpAction()
		if isJumping or isFalling or isFlying then return end

		if isWalkingOnWater or isGrounded() then
			waterJumpCooldown = tick() + 0.5
			isWalkingOnWater = false
			if waterPlatform then waterPlatform.CanCollide = false end
			isJumping = true
