	local function isGrounded()
		local rayParams = RaycastParams.new()
		local filterInstances = {character}
		if waterPlatform then table.insert(filterInstances, waterPlatform) end
		rayParams.FilterDescendantsInstances = filterInstances
		rayParams.FilterType = Enum.RaycastFilterType.Exclude
		rayParams.IgnoreWater = true
		
		local hipHeight = humanoid.HipHeight > 0 and humanoid.HipHeight or 2
		local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -(hipHeight + 1.5), 0), rayParams)
		return rayResult ~= nil
	end

	local function stopAirAnimations()
		if normalJumpTrack and normalJumpTrack.IsPlaying then normalJumpTrack:Stop(0.1) end
		if sprintJumpTrack and sprintJumpTrack.IsPlaying then sprintJumpTrack:Stop(0.1) end
		if normalFallTrack and normalFallTrack.IsPlaying then normalFallTrack:Stop(0.1) end
		if sprintFallTrack and sprintFallTrack.IsPlaying then sprintFallTrack:Stop(0.1) end
	end

	local function stopClimbAnimations()
		if normalClimbTrack and normalClimbTrack.IsPlaying then normalClimbTrack:Stop(0.1) end
		if sprintClimbTrack and sprintClimbTrack.IsPlaying then sprintClimbTrack:Stop(0.1) end
	end

	local function detachFromWall()
		if not isWallRunning then return end
		isWallRunning = false
		humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
		stopClimbAnimations()
		if sprintClimbTrack then sprintClimbTrack:AdjustSpeed(1) end

		stopAirAnimations()
		
		local currentY = rootPart.AssemblyLinearVelocity.Y
		if currentY > 1 then
			isJumping = true
			isFalling = false
			local trackToPlay = (isSprinting and sprintJumpTrack) or normalJumpTrack
			if trackToPlay then
				stopAllAnimationsExcept(trackToPlay)
				trackToPlay:Play(0.1)
			end
		else
			isFalling = true
			isJumping = false
			local trackToPlay = (isSprinting and sprintFallTrack) or normalFallTrack
			if trackToPlay then
				stopAllAnimationsExcept(trackToPlay)
				trackToPlay:Play(0.1)
			end
		end
	end

	local function stopGliding()
		isGliding = false
		persistentTrail.Enabled = false
		if linearVelocity then linearVelocity:Destroy(); linearVelocity = nil end
		if glideAttachment then glideAttachment:Destroy(); glideAttachment = nil end
	end

	local function startGliding()
		if isGliding or not isSprinting or not isGlideActive or isFlying then return end
		local rayParams = RaycastParams.new()
		local filterInstances = {character}
		if waterPlatform then table.insert(filterInstances, waterPlatform) end
		rayParams.FilterDescendantsInstances = filterInstances
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -500, 0), rayParams)
		local groundHeight = rayResult and (rootPart.Position.Y - rayResult.Position.Y) or 0
		
		calculatedGlideDuration = math.min(CFG.BaseGlideDuration + (groundHeight * CFG.HeightBonusFactor), CFG.MaxGlideDuration)
		isGliding = true
		glideStartTime = tick()

		if not glideAttachment then
			glideAttachment = Instance.new("Attachment")
			glideAttachment.Parent = rootPart
		end
		if not linearVelocity then
			linearVelocity = Instance.new("LinearVelocity")
			linearVelocity.Attachment0 = glideAttachment
			linearVelocity.MaxForce = 500000
			linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
			linearVelocity.Parent = rootPart
		end
		persistentTrail.Enabled = true
	end

	local function setAntiFlingState(enable)
		isAntiFlingActive = enable
		if antiFlingConn then antiFlingConn:Disconnect(); antiFlingConn = nil end
		if isAntiFlingActive then
			antiFlingConn = RunService.Stepped:Connect(function()
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player and p.Character then
						for _, part in ipairs(p.Character:GetDescendants()) do
							if part:IsA("BasePart") then part.CanCollide = false end
						end
					end
				end
			end)
		end
	end

	local function setNoclipState(enable)
		isNoclipActive = enable
		CFG.AutoNoclipOnExec = enable
		saveCFG()
		if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
		if isNoclipActive then
			noclipConn = RunService.Stepped:Connect(function()
				if character then
					for _, part in ipairs(character:GetDescendants()) do
						if part:IsA("BasePart") then part.CanCollide = false end
					end
				end
			end)
		else
			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						if table.find({"HumanoidRootPart", "Torso", "UpperTorso", "LowerTorso", "Head"}, part.Name) then
							part.CanCollide = true
						else
							part.CanCollide = false
						end
					end
				end
			end
		end
	end

