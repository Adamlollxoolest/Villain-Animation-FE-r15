	local function updateColorFromInput(inputPos)
		local absPos = pickerBox.AbsolutePosition
		local absSize = pickerBox.AbsoluteSize
		
		local relX = math.clamp((inputPos.X - absPos.X) / absSize.X, 0, 1)
		local relY = math.clamp((inputPos.Y - absPos.Y) / absSize.Y, 0, 1)
		
		selectorCircle.Position = UDim2.new(relX, 0, relY, 0)
		
		local hue = relX
		local saturation = 1 - (relY * 0.5)
		local value = 1 - relY
		
		local rgbColor = Color3.fromHSV(hue, saturation, value)
		applyColorValues(rgbColor.R * 255, rgbColor.G * 255, rgbColor.B * 255)
	end

