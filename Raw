local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local SAVE_FILE_NAME = "CFG_SavedSettings.json"

-- ==========================================
-- DEFAULT CFG (CONFIGURATION)
-- ==========================================
local CFG = {
	WalkSpeed = 16,
	SprintSpeed = 235,
	WallRunSpeed = 200,
	JumpPower = 80,
	
	-- Glide Settings
	BaseGlideDuration = 1.0,
	HeightBonusFactor = 0.05,
	MaxGlideDuration = 10.0,
	GlideFallSpeed = -5,
	GlideForwardMultiplier = 1.2,

	-- Execution & Trigger Automation Flags
	AutoAntiFlingOnExec = false,
	AutoSprintOnExec = false,
	AutoNoclipOnExec = false,
	AutoGlideOnSprint = false,
	AutoWallRunOnSprint = false
}

-- Global toggle states
local isNoclipActive = false

-- Save & Load Helpers (Executor File I/O Compatibility)
local function saveCFG()
	if writefile then
		pcall(function()
			writefile(SAVE_FILE_NAME, HttpService:JSONEncode(CFG))
		end)
	end
end

local function loadCFG()
	if readfile and isfile and isfile(SAVE_FILE_NAME) then
		pcall(function()
			local decoded = HttpService:JSONDecode(readfile(SAVE_FILE_NAME))
			for key, val in pairs(decoded) do
				CFG[key] = val
			end
		end)
	end
end

loadCFG()

