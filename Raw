	colorTrailMenuBtn.Position = UDim2.new(0, 10, 0, 485)
	colorTrailMenuBtn.BackgroundColor3 = Color3.fromRGB(70, 130, 180)
	colorTrailMenuBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	colorTrailMenuBtn.Text = "Color Trail Settings"
	colorTrailMenuBtn.Font = Enum.Font.SourceSansBold
	colorTrailMenuBtn.TextSize = 14
	colorTrailMenuBtn.Parent = cfgFrame

	local ctmCorner = Instance.new("UICorner")
	ctmCorner.CornerRadius = UDim.new(0, 6)
	ctmCorner.Parent = colorTrailMenuBtn

	colorTrailMenuBtn.MouseButton1Click:Connect(function()
		colorTrailFrame.Visible = not colorTrailFrame.Visible
	end)

	cfgBtn.MouseButton1Click:Connect(function()
		cfgFrame.Visible = not cfgFrame.Visible
	end)

	wallRunBtn.Visible = false
	glideBtn.Visible = false

	return sprintBtn, antiFlingBtn, wallRunBtn, glideBtn, setNoclipUI
end

local function setupCustomAnimations(character)
	local humanoid = character:WaitForChild("Humanoid")
	local rootPart = character:WaitForChild("HumanoidRootPart")
	
	local torsoPart = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso") or rootPart
	
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("LocalScript") and (child.Name == "Animate" or child.Name == "AnimationScript") then
			child.Disabled = true
			child:Destroy()
		end
	end

	humanoid.WalkSpeed = CFG.WalkSpeed
	humanoid.UseJumpPower = true
	humanoid.JumpPower = CFG.JumpPower

	task.wait(0.2)
	local animator = humanoid:WaitForChild("Animator")

	humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
		if humanoid.JumpPower ~= CFG.JumpPower then
			humanoid.JumpPower = CFG.JumpPower
		end
	end)

	local function loadAnimation(assetId, priority, looped)
		local anim = Instance.new("Animation")
		anim.AnimationId = assetId
		
		local success, track = pcall(function()
			return animator:LoadAnimation(anim)
		end)
		
		if not success or not track then return nil end

		track.Priority = priority or Enum.AnimationPriority.Action
		track.Looped = looped ~= nil and looped or false
		track:AdjustWeight(1)
		track:AdjustSpeed(1)
		return track
	end

	local idleTrack = loadAnimation(ANIMATIONS.Idle, Enum.AnimationPriority.Idle, true)
	local walkTrack = loadAnimation(ANIMATIONS.Walk, Enum.AnimationPriority.Movement, true)
	local runTrack = loadAnimation(ANIMATIONS.Run, Enum.AnimationPriority.Movement, true)
	
	local normalJumpTrack = loadAnimation(ANIMATIONS.NormalJump, Enum.AnimationPriority.Action, false)
	local sprintJumpTrack = loadAnimation(ANIMATIONS.SprintJump, Enum.AnimationPriority.Action, false)
	local normalFallTrack = loadAnimation(ANIMATIONS.NormalFall, Enum.AnimationPriority.Action, true)
	local sprintFallTrack = loadAnimation(ANIMATIONS.SprintFall, Enum.AnimationPriority.Action, true)
	
	local normalClimbTrack = loadAnimation(ANIMATIONS.NormalClimb, Enum.AnimationPriority.Action, true)
	local sprintClimbTrack = loadAnimation(ANIMATIONS.SprintClimb, Enum.AnimationPriority.Action, true)

	local isFalling, isJumping, isSprinting = false, false, false
	local isWallRunning, isWallRunActive, isGlideActive, isGliding, isAntiFlingActive = false, false, false, false, false
	local isWalkOnWaterActive, isWalkingOnWater = false, false
	local waterJumpCooldown = 0 -- Grace period to ensure jumping off water works
	
	local glideStartTime = 0
	local calculatedGlideDuration = CFG.BaseGlideDuration
	local linearVelocity, glideAttachment = nil, nil
	local noclipConn, renderConn, antiFlingConn, speedLockConn = nil, nil, nil, nil
	local currentMovementTrack = nil

	local att0 = Instance.new("Attachment")
	att0.Position = Vector3.new(0, 0.7, 0.5)
	att0.Parent = torsoPart

	local att1 = Instance.new("Attachment")
	att1.Position = Vector3.new(0, -0.5, 0.6)
	att1.Parent = torsoPart

	local persistentTrail = Instance.new("Trail")
	persistentTrail.Attachment0 = att0
	persistentTrail.Attachment1 = att1
	persistentTrail.Lifetime = 0.4
	persistentTrail.MinLength = 0.05
	
	persistentTrail.WidthScale = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1.2),
		NumberSequenceKeypoint.new(1, 0.0)
	})
	
	local function updateTrailColor(r, g, b)
		local baseColor = Color3.fromRGB(r, g, b)
		persistentTrail.Color = ColorSequence.new(baseColor, Color3.fromRGB(math.clamp(r+50,0,255), math.clamp(g+50,0,255), math.clamp(b+50,0,255)))
	end

	updateTrailColor(CFG.TrailColorR, CFG.TrailColorG, CFG.TrailColorB)

	persistentTrail.Transparency = NumberSequence.new(0.05, 1)
	persistentTrail.LightEmission = 1
	persistentTrail.Enabled = false
	persistentTrail.Parent = torsoPart

	local function playMovementTrack(track)
		if not track then return end
		if currentMovementTrack == track then
			if not track.IsPlaying then track:Play(0.1) end
			return
		end

		if currentMovementTrack and currentMovementTrack.IsPlaying then
			currentMovementTrack:Stop(0.1)
		end

		currentMovementTrack = track
		if not track.IsPlaying then
			track:Play(0.1)
		end
	end

	local function stopAirAnimations()
		if normalJumpTrack and normalJumpTrack.IsPlaying then normalJumpTrack:Stop() end
		if sprintJumpTrack and sprintJumpTrack.IsPlaying then sprintJumpTrack:Stop() end
		if normalFallTrack and normalFallTrack.IsPlaying then normalFallTrack:Stop() end
		if sprintFallTrack and sprintFallTrack.IsPlaying then sprintFallTrack:Stop() end
	end

	local function stopClimbAnimations()
		if normalClimbTrack and normalClimbTrack.IsPlaying then normalClimbTrack:Stop() end
		if sprintClimbTrack and sprintClimbTrack.IsPlaying then sprintClimbTrack:Stop() end
	end

	local function stopGliding()
		isGliding = false
		persistentTrail.Enabled = false
		if linearVelocity then linearVelocity:Destroy(); linearVelocity = nil end
		if glideAttachment then glideAttachment:Destroy(); glideAttachment = nil end
	end

	local function startGliding()
		if isGliding or not isSprinting or not isGlideActive then return end
		
		local rayParams = RaycastParams.new()
		rayParams.FilterDescendantsInstances = {character}
		rayParams.FilterType = Enum.RaycastFilterType.Exclude

		local rayResult = workspace:Raycast(rootPart.Position, Vector3.new(0, -500, 0), rayParams)
		local groundHeight = rayResult and (rootPart.Position.Y - rayResult.Position.Y) or 0
		
		calculatedGlideDuration = math.min(CFG.BaseGlideDuration + (groundHeight * CFG.HeightBonusFactor), CFG.MaxGlideDuration)
		isGliding = true
		glideStartTime = tick()

		if not glideAttachment then
			glideAttachment = Instance.new("Attachment")
			glideAttachment.Parent = rootPart
		end

		if not linearVelocity then
			linearVelocity = Instance.new("LinearVelocity")
			linearVelocity.Attachment0 = glideAttachment
			linearVelocity.MaxForce = 500000
			linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
			linearVelocity.Parent = rootPart
		end

		persistentTrail.Enabled = true
	end

	local function setAntiFlingState(enable)
		isAntiFlingActive = enable
		if antiFlingConn then antiFlingConn:Disconnect(); antiFlingConn = nil end

		if isAntiFlingActive then
			antiFlingConn = RunService.Stepped:Connect(function()
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= player and p.Character then
						for _, part in ipairs(p.Character:GetDescendants()) do
							if part:IsA("BasePart") then
								part.CanCollide = false
							end
						end
					end
				end
			end)
		end
	end

	local function setNoclipState(enable)
		isNoclipActive = enable
		if noclipConn then noclipConn:Disconnect(); noclipConn = nil end

		if isNoclipActive then
			noclipConn = RunService.Stepped:Connect(function()
				if character then
					for _, part in ipairs(character:GetDescendants()) do
						if part:IsA("BasePart") then part.CanCollide = false end
					end
				end
			end)
		else
			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						if part.Name == "HumanoidRootPart" or part.Name == "Torso" or part.Name == "UpperTorso" or part.Name == "LowerTorso" or part.Name == "Head" then
							part.CanCollide = true
						else
							part.CanCollide = false
						end
					end
				end
			end
		end
	end

	local sprintBtn, antiFlingBtn, wallRunBtn, glideBtn, updateNoclipUI = createMobileUI(setNoclipState, updateTrailColor)

	local function toggleSprint(enable)
		isSprinting = enable
		humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
		wallRunBtn.Visible = isSprinting
		glideBtn.Visible = isSprinting

		if speedLockConn then speedLockConn:Disconnect(); speedLockConn = nil end
		if isSprinting then
			speedLockConn = RunService.Heartbeat:Connect(function()
				if isSprinting and humanoid and humanoid.Parent then
					if humanoid.WalkSpeed ~= CFG.SprintSpeed then
						humanoid.WalkSpeed = CFG.SprintSpeed
					end
				end
			end)

			sprintBtn.Text = "Sprint: ON"
			sprintBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
			if CFG.AutoGlideOnSprint then isGlideActive = true; glideBtn.Text = "Glide: ON"; glideBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) end
			if CFG.AutoWallRunOnSprint then isWallRunActive = true; wallRunBtn.Text = "Wall Run: ON"; wallRunBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50) end
			if CFG.AutoWalkOnWaterOnSprint then isWalkOnWaterActive = true end
		else
			sprintBtn.Text = "Sprint: OFF"
			sprintBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			isWallRunActive = false
			isWallRunning = false
			isGlideActive = false
			isWalkOnWaterActive = false
			isWalkingOnWater = false
			stopGliding()
			wallRunBtn.Text = "Wall Run: OFF"; wallRunBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			glideBtn.Text = "Glide: OFF"; glideBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50)
			stopClimbAnimations()
		end
	end

	UserInputService.InputBegan:Connect(function(input, gpe)
		if gpe then return end
		if input.KeyCode == Enum.KeyCode.LeftShift then toggleSprint(true) end
		if input.KeyCode == Enum.KeyCode.Space then
			if isWalkingOnWater then
				waterJumpCooldown = tick() + 0.35 -- Allow jump freedom off water for 350ms
				isWalkingOnWater = false
				isJumping = true
				isFalling = false
				stopAirAnimations()
				if isSprinting then
					if sprintJumpTrack then sprintJumpTrack:Play() end
				else
					if normalJumpTrack then normalJumpTrack:Play() end
				end
			end
		end
		if input.KeyCode == Enum.KeyCode.N then
			local newState = not isNoclipActive
			setNoclipState(newState)
			CFG.AutoNoclipOnExec = newState
			if updateNoclipUI then updateNoclipUI(newState) end
			saveCFG()
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.LeftShift then toggleSprint(false) end
	end)

	sprintBtn.MouseButton1Click:Connect(function() toggleSprint(not isSprinting) end)

	antiFlingBtn.MouseButton1Click:Connect(function()
		isAntiFlingActive = not isAntiFlingActive
		antiFlingBtn.Text = isAntiFlingActive and "Anti Fling: ON" or "Anti Fling: OFF"
		antiFlingBtn.BackgroundColor3 = isAntiFlingActive and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(220, 50, 50)
		setAntiFlingState(isAntiFlingActive)
	end)

	wallRunBtn.MouseButton1Click:Connect(function()
		isWallRunActive = not isWallRunActive
		wallRunBtn.Text = isWallRunActive and "Wall Run: ON" or "Wall Run: OFF"
		wallRunBtn.BackgroundColor3 = isWallRunActive and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(220, 50, 50)
		if not isWallRunActive then isWallRunning = false; stopClimbAnimations() end
	end)

	glideBtn.MouseButton1Click:Connect(function()
		isGlideActive = not isGlideActive
		glideBtn.Text = isGlideActive and "Glide: ON" or "Glide: OFF"
		glideBtn.BackgroundColor3 = isGlideActive and Color3.fromRGB(50, 200, 50) or Color3.fromRGB(220, 50, 50)
		if not isGlideActive then stopGliding() end
	end)

	task.defer(function()
		if CFG.AutoAntiFlingOnExec then
			antiFlingBtn.Text = "Anti Fling: ON"
			antiFlingBtn.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
			setAntiFlingState(true)
		end
		if CFG.AutoSprintOnExec then toggleSprint(true) end
		if CFG.AutoNoclipOnExec then setNoclipState(true) end
		if CFG.Shiftlock then setShiftlockState(true) end
		if CFG.AutoWalkOnWaterOnSprint then isWalkOnWaterActive = true end
	end)

	renderConn = RunService.RenderStepped:Connect(function()
		if isSprinting and humanoid.MoveDirection.Magnitude > 0.1 then
			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = {character}
			rayParams.FilterType = Enum.RaycastFilterType.Exclude

			local moveDir = humanoid.MoveDirection
			local rayResult = workspace:Raycast(rootPart.Position, moveDir * 4.5, rayParams)
			
			if rayResult and rayResult.Instance and rayResult.Instance.CanCollide and math.abs(rayResult.Normal.Y) < 0.3 then
				local currentVel = rootPart.AssemblyLinearVelocity
				rootPart.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
			end
		end

		if isSprinting and isWallRunActive then
			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = {character}
			rayParams.FilterType = Enum.RaycastFilterType.Exclude

			local rayResult = workspace:Raycast(rootPart.Position, rootPart.CFrame.LookVector * 3.5, rayParams)
			if rayResult and rayResult.Instance and rayResult.Instance.CanCollide and math.abs(rayResult.Normal.Y) < 0.3 then
				if not isWallRunning then
					isWallRunning = true
					stopGliding()
					stopAirAnimations()
					if sprintClimbTrack then sprintClimbTrack:Play() end
				end
				rootPart.AssemblyLinearVelocity = Vector3.new(0, CFG.WallRunSpeed, 0)
				return
			end
		end

		if isWallRunning then
			isWallRunning = false
			humanoid.WalkSpeed = isSprinting and CFG.SprintSpeed or CFG.WalkSpeed
			stopClimbAnimations()
		end

		if isSprinting and isWalkOnWaterActive and tick() > waterJumpCooldown then
			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = {character}
			rayParams.FilterType = Enum.RaycastFilterType.Exclude

			local rayResult = workspace:Raycast(rootPart.Position + Vector3.new(0, 2, 0), Vector3.new(0, -15, 0), rayParams)
			if rayResult and rayResult.Instance then
				local mat = rayResult.Material
				if mat == Enum.Material.Water or string.find(string.lower(rayResult.Instance.Name), "water") then
					isWalkingOnWater = true
					stopGliding()
					local targetY = rayResult.Position.Y + CFG.WalkOnWaterHeightOffset
					local curVel = rootPart.AssemblyLinearVelocity
					rootPart.AssemblyLinearVelocity = Vector3.new(curVel.X, 0, curVel.Z)
					rootPart.CFrame = CFrame.new(rootPart.Position.X, targetY, rootPart.Position.Z) * rootPart.CFrame.Rotation
				else
					isWalkingOnWater = false
				end
			else
				isWalkingOnWater = false
			end
		else
			isWalkingOnWater = false
		end

		if isGliding then
			if (tick() - glideStartTime) > calculatedGlideDuration then
				stopGliding()
			else
				local moveDir = humanoid.MoveDirection
				local moveVel = moveDir * (CFG.SprintSpeed * CFG.GlideForwardMultiplier)
				linearVelocity.VectorVelocity = Vector3.new(moveVel.X, CFG.GlideFallSpeed, moveVel.Z)
				if moveDir.Magnitude > 0.1 then
					rootPart.CFrame = CFrame.lookAt(rootPart.Position, rootPart.Position + Vector3.new(moveDir.X, 0, moveDir.Z).Unit)
				end
			end
		end

		local state = humanoid:GetState()
		if humanoid.MoveDirection.Magnitude <= 0.1 and not isGliding and not isWalkingOnWater and (state == Enum.HumanoidStateType.Running or state == Enum.HumanoidStateType.RunningNoPhysics) then
			rootPart.AssemblyLinearVelocity = Vector3.new(0, rootPart.AssemblyLinearVelocity.Y, 0)
		end

		-- Handle normal ground + water walking animations
		if (state ~= Enum.HumanoidStateType.Freefall and state ~= Enum.HumanoidStateType.Jumping and not isWallRunning) or isWalkingOnWater then
			isFalling = false
			isJumping = false
			
			if humanoid.MoveDirection.Magnitude > 0.1 then
				if isSprinting then
					playMovementTrack(runTrack)
				else
					playMovementTrack(walkTrack)
				end
			else
				playMovementTrack(idleTrack)
			end
		end

		if state == Enum.HumanoidStateType.Freefall and not isWalkingOnWater then
			if not isFalling then
				isFalling = true
				isJumping = false
				stopAirAnimations()
				if isSprinting then
					if sprintFallTrack then sprintFallTrack:Play() end
				else
					if normalFallTrack then normalFallTrack:Play() end
				end
			end
			if isSprinting and isGlideActive and not isGliding and rootPart.AssemblyLinearVelocity.Y <= 2 then
				startGliding()
			end
		end
	end)

	humanoid.StateChanged:Connect(function(oldState, newState)
		if newState == Enum.HumanoidStateType.Jumping then
			isJumping = true; isFalling = false; stopGliding(); isWalkingOnWater = false
			waterJumpCooldown = tick() + 0.35
			stopAirAnimations()
			if isSprinting then
				if sprintJumpTrack then sprintJumpTrack:Play() end
			else
				if normalJumpTrack then normalJumpTrack:Play() end
			end
		elseif newState == Enum.HumanoidStateType.Landed then
			isJumping = false; isFalling = false; stopGliding(); stopAirAnimations()
		end
	end)

	playMovementTrack(idleTrack)

	humanoid.Died:Connect(function()
		if speedLockConn then speedLockConn:Disconnect() end
		stopGliding()
		setAntiFlingState(false)
		setNoclipState(false)
		if renderConn then renderConn:Disconnect() end
	end)
end

if player.Character then setupCustomAnimations(player.Character) end
player.CharacterAdded:Connect(setupCustomAnimations)
